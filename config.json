{
  "email": "trent@teambuildr.com",
  "people_dir": "data/people",
  "brief_subject_prefix": "\u2600\ufe0f Morning Brief",
  "calendar_ids": [
    "primary"
  ],
  "unread_email_max": 15,
  "starred_email_max": 10,
  "ai_model": "claude-sonnet-4-6",
  "state_dir": "data/state",
  "projects_file": "data/projects.md",
  "recurring_file": "data/recurring.json",
  "dashboard_path": "output/dashboard.html",
  "notion": {
    "enabled": false,
    "inbox_database_id": "",
    "inbox_filter_status": [
      "Inbox",
      "Processing"
    ]
  },
  "slack_channels": [
    "TeamBuildr-OS",
    "support",
    "support-tickets"
  ],
  "nudge_minutes_after": 5,
  "pending_nudges_file": "data/pending_nudges.json",
  "issues_file": "data/issues.json",
  "drafts_dir": "data/drafts",
  "captures_file": "data/captures.md",
  "brief_feedback_file": "data/brief_feedback.md",
  "issue_auto_resolve_days": 3,
  "inbox_file": "",
  "pipeline": {
    "enabled": true,
    "cache_path": "data/pipeline_cache.json",
    "trial_followup_after_days": 5,
    "stale_after_days": 14,
    "cache_stale_warn_days": 7
  },
  "gym_scout": {
    "enabled": true,
    "results_csv": "data/gym_scout_results.csv",
    "lookback_days": 7
  },
  "memory": {
    "enabled": true,
    "dir": "data/memory",
    "observations_file": "data/memory/observations.jsonl",
    "decisions_file": "data/memory/decisions.md",
    "archive_dir": "data/memory/archive",
    "observation_lookback_days": 30,
    "default_ttl_days": 90,
    "activity_extension_days": 30,
    "cold_start_days": 3,
    "retrieval_token_budget": 550,
    "abandon_threshold_days": 60,
    "abandon_ttl_days": 14
  },
  "logs_file": "data/logs/run_log.jsonl",
  "brief_scores_file": "data/state/brief_scores.jsonl",
  "email_automation_filters": {
    "exclude_sender_patterns": [
      "noreply@",
      "no-reply@",
      "donotreply@",
      "notifications@",
      "alerts@",
      "mailer@",
      "accounts.google.com",
      "support@github.com",
      "noreply-demo@gymstudio.com"
    ],
    "exclude_subject_patterns": [
      "Member payment failed:",
      "Your export "
    ]
  },
  "vector": {
    "enabled": true,
    "index_name": "chief-of-staff",
    "embedding_model": "voyage-3-lite",
    "embedding_dimension": 512,
    "observations_namespace": "observations",
    "memories_namespace": "memories",
    "ingest_state_file": "data/vector_ingest_state.json",
    "retrieval_mode": "auto",
    "retrieval_log_file": "data/state/retrieval_log.jsonl"
  }
}